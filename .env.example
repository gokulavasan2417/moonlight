MONGOMS_VERSION=8.2.6
SEED_DEMO_DATA=true

# JWT Secret
JWT_SECRET=moon_light_villa_super_secret_jwt_key_2026_xyz

# Razorpay Payment Gateway (Test or Live credentials; sandbox mock engine active if blank)
