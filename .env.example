RAZORPAY_KEY_SECRET=

# Email Notifications (Nodemailer SMTP; simulated logging active if blank)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=reservations@moonlightvilla.com

# WhatsApp Notifications (Meta Cloud API / Twilio; simulated logging active if blank)
